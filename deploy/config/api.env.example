ConnectionStrings__PostgreSQL=Host=verum-postgres;Database=verum;Username=verum;Password=CHANGE_ME
ConnectionStrings__Redis=verum-redis:6379,password=CHANGE_ME,abortConnect=false
RabbitMQ__Enabled=true
RabbitMQ__Host=verum-rabbitmq
RabbitMQ__Username=verum
RabbitMQ__Password=CHANGE_ME
Redis__Enabled=true
Authentication__Authority=https://auth.example.com/realms/verum
Authentication__Audience=verum-api
Authentication__RequireHttpsMetadata=true
AllowedHosts=app.example.com
HEALTHCHECK_HOST=app.example.com
ReverseProxy__KnownNetworks__0=172.30.0.0/24
DataProtection__KeysPath=/var/lib/verum/keys
DataProtection__ApplicationName=Verum.Api
Assinaturas__Habilitado=false
InteligenciaArtificial__Enabled=false
Radar__Habilitado=false
Radar__LimiteMonitoramentos=10
Radar__IntervaloVerificacaoMinutos=360
Radar__CooldownMinutos=1440
Radar__HisteresePercentual=2
Notificacoes__Email__Habilitado=false
Notificacoes__Email__Host=smtp.example.com
Notificacoes__Email__Porta=587
Notificacoes__Email__Tls=true
Notificacoes__Email__Remetente=radar@example.com
