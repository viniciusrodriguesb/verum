{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMQ": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "UseSsl": false,
    "PrefetchCount": 16,
    "ConcurrentMessageLimit": 8,
    "RetryCount": 3,
    "PublishTimeoutSeconds": 15,
    "UseDelayedRedelivery": false,
    "UseInMemoryOutbox": true,
    "RedeliveryIntervalsSeconds": [
      30,
      120,
      600
    ]
  },
  "Redis": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "PostgreSQL": "",
    "Redis": ""
  },
  "Http": {
    "Resilience": {
      "TotalRequestTimeout": {
        "Timeout": "00:00:30"
      },
      "AttemptTimeout": {
        "Timeout": "00:00:10"
      },
      "Retry": {
        "MaxRetryAttempts": 3,
        "Delay": "00:00:01",
        "UseJitter": true
      }
    }
  },
  "Observability": {
    "OtlpEnabled": false
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "verum-api",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "Origins": []
  }
}

