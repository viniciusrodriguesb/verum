{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMQ": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "UseSsl": false,
    "PrefetchCount": 16,
    "ConcurrentMessageLimit": 8,
    "RetryCount": 3,
    "PublishTimeoutSeconds": 15,
    "UseDelayedRedelivery": false,
    "UseInMemoryOutbox": true,
    "RedeliveryIntervalsSeconds": [
      30,
      120,
      600
    ]
  },
  "Redis": {
    "Enabled": false,
    "Prefixo": "verum:",
    "TimeoutMilissegundos": 1000,
    "StatusBuscaTtl": "00:00:05",
    "ResultadoBuscaTtl": "00:15:00",
    "CatalogoTtl": "06:00:00",
    "ResolucaoConsultaTtl": "01:00:00",
    "OfertasTtl": "00:02:00",
    "AcessoTtl": "00:00:30"
  },
  "ConnectionStrings": {
    "PostgreSQL": "",
    "Redis": ""
  },
  "Http": {
    "Resilience": {
      "TotalRequestTimeout": {
        "Timeout": "00:00:30"
      },
      "AttemptTimeout": {
        "Timeout": "00:00:10"
      },
      "Retry": {
        "MaxRetryAttempts": 3,
        "Delay": "00:00:01",
        "UseJitter": true
      }
    }
  },
  "Observability": {
    "OtlpEnabled": false
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "verum-api",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "Origins": []
  }
}

